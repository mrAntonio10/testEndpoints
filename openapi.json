{
  "openapi": "3.0.3",
  "info": {
    "title": "ReKids · API comercial de solo lectura",
    "version": "0.3.0-sandbox-package",
    "description": "API instalable de solo lectura sobre datos ficticios. No desplegada por FORGE. Hospedar en la infraestructura del desarrollador y reemplazar el servidor ficticio tras verificarla. No ofrece acceso a ReKids real."
  },
  "servers": [
    {
      "url": "https://su-sandbox.example.invalid/integrations/v1",
      "description": "Reemplazar por el gateway HTTPS instalado en SU infraestructura."
    }
  ],
  "x-status": "installable-synthetic-sandbox",
  "x-credential-issued": false,
