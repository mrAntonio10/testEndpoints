  "components": {
    "securitySchemes": {
      "IntegrationBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer opaco exclusivo de integración; 256 bits. La base comprueba hash, entorno físico, sucursal, scopes, expiración y revocación en cada consulta. Sin cuenta de personal o administrador. Guardar solo en backend Java. Permisos indicados en x-required-scopes."
      }
    },
    "schemas": {
      "Branch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "ID comercial de sucursal.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Nombre comercial."
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Photo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "ID de imagen.",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "description": "URL de imagen comercial aprobada; nunca un archivo privado.",
            "format": "uri"
          },
          "primary": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "url",
          "primary"
        ]
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador estable de prenda; usar este ID al crear el pedido.",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "description": "Código actual único."
          },
          "legacy_code": {
            "type": "string",
            "description": "Código anterior que puede tener varias coincidencias.",
            "nullable": true
          },
          "branch_id": {
            "type": "string",
            "description": "Sucursal autorizada. Enviarla no concede acceso.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Descripción comercial."
          },
          "category": {
            "type": "string",
            "description": "Categoría comercial."
          },
          "size": {
            "type": "string",
            "description": "Talla.",
            "nullable": true
          },
          "brand": {
            "type": "string",
            "description": "Marca.",
            "nullable": true
          },
          "condition": {
            "type": "string",
            "description": "Estado comercial descriptivo."
          },
          "price": {
            "type": "string",
            "description": "Importe BOB como cadena decimal; el servidor calcula el importe definitivo.",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "example": "55.00"
          },
          "currency": {
            "type": "string",
            "enum": [
              "BOB"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Photo"
            }
          },
          "updated_at": {
            "type": "string",
            "description": "Fecha UTC ISO-8601.",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "code",
          "legacy_code",
          "branch_id",
          "name",
          "category",
          "size",
          "brand",
          "condition",
          "price",
          "currency",
          "availability",
          "photos",
          "updated_at",
          "version"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "description": "Código estable de error."
          },
          "message": {
            "type": "string",
            "description": "Descripción segura sin datos internos."
          },
          "request_id": {
            "type": "string",
            "description": "Correlación para soporte.",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      }
    }
  }
}
